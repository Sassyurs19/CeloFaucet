# ==========================================
# Telegram Celo USAT Payment Bot Configuration
# ==========================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram numeric User ID (obtain from @userinfobot or @rawdatabot)
ADMIN_TELEGRAM_ID=123456789
ADMIN_WEB_PASSWORD=

# Celo Network RPC Configuration
# Official public Celo Mainnet RPC: https://forno.celo.org
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220
NETWORK_NAME=Celo Mainnet

# USAT Contract on Celo Mainnet
USAT_CONTRACT_ADDRESS=0xd2ab3c9a02dbbab236bfec45d1d755df4267f771
USAT_PAYMENT_AMOUNT=2.00

# Public USAT reward pool shown read-only on the dashboard (not a secret)
REWARD_POOL_ADDRESS=0x6fc8bdcad9d4c36fffcf101b633df7b078a221fe

# Dedicated CELO Gas Funding Wallet
# Automatically funds 0.05 CELO to user wallets with low balance for gas fees
FUNDING_WALLET_PRIVATE_KEY=
FUNDING_WALLET_ADDRESS=
CELO_FUNDING_AMOUNT=0.05
MIN_GAS_RESERVE=0.02

# Master AES-256-GCM Wallet Encryption Key (64 hex characters)
# Required for imported wallets. The backend never generates a replacement.
WALLET_ENCRYPTION_KEY=

# Render & Web Service Configuration
# Render sets the PORT environment variable dynamically
NODE_ENV=development
PORT=8080
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Production Firebase Frontend URL (allowed for CORS)
FRONTEND_URL=https://celofaucet.web.app

# Optional public HTTPS domain (e.g. Render public URL)
WEBAPP_PUBLIC_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Block Explorer URL
EXPLORER_TX_URL=https://celoscan.io/tx/

# Database: PostgreSQL is mandatory when NODE_ENV=production. SQLite is local-development only.
DATABASE_URL=
# Local-development SQLite Database Location
DATABASE_PATH=data/faucet.db

# Minimum CELO balance threshold below which auto-gas subsidy is triggered
MIN_USER_CELO_THRESHOLD=0.005

# Safety & Test Mode (DRY_RUN=false broadcasts real on-chain transactions)
DRY_RUN=false
